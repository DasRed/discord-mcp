{
    "name": "@dasred/discord-mcp",
    "version": "1.2.1",
    "description": "Streamable HTTP MCP server for Discord (servers, channels, messages) using a Discord user session, packaged as a Docker image",
    "type": "module",
    "author": "Marco Starker",
    "license": "MIT",
    "private": true,
    "bugs": {
        "url": "https://github.com/dasred/discord-mcp/issues"
    },
    "homepage": "https://www.marco-starker.de/en/projects/discord-mcp/docs",
    "engines": {
        "node": ">=26.12.1",
        "npm": ">=11.20.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dasred/discord-mcp.git"
    },
    "files": [
        "dist/*"
    ],
    "scripts": {
        "build": "tsc && tsc-alias",
        "test": "vitest run",
        "coverage": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/reports/unittest.xml",
        "start": "node ./dist/index.js",
        "dev": "tsx watch ./src/index.ts",
        "preview": "node --watch-path=./dist ./dist/index.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "dotenv": "^18.0.10",
        "fastify": "^5.12.8",
        "luxon": "^3.7.2",
        "playwright": "^1.65.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/luxon": "^3.7.6",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.1",
        "tsc-alias": "^1.9.10",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.1"
    }
}
