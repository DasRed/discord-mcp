# Address the HTTP server listens on
# optional, default=0.0.0.0
#DISCORD_MCP_SERVER_HOST=0.0.0.0

# Port the HTTP server listens on
# optional, default=3000
#DISCORD_MCP_SERVER_PORT=3000

# Log level of the HTTP server (fatal, error, warn, info, debug, trace, silent)
# optional, default=info
#DISCORD_MCP_SERVER_LOG_LEVEL=info

# Path of the MCP endpoint
# optional, default=/mcp
#DISCORD_MCP_PATH=/mcp

# Only expose read-only tools (get_servers, get_channels, read_messages)
# optional, default=true
#DISCORD_MCP_READ_ONLY=true

# Bearer token required on the MCP endpoint, empty disables the check
# optional, default=
#DISCORD_MCP_AUTH_TOKEN=a-long-random-secret

# Email of the Discord account, used when no valid session exists
# required unless DISCORD_MCP_DISCORD_TOKEN is set or a session is stored in the data directory
#DISCORD_MCP_DISCORD_EMAIL=me@example.com

# Password of the Discord account
# required together with DISCORD_MCP_DISCORD_EMAIL
#DISCORD_MCP_DISCORD_PASSWORD=secret

# Base32 secret of the authenticator app, needed for accounts with two-factor authentication
# optional, default=
#DISCORD_MCP_DISCORD_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Discord session token; when set, no browser login happens
# optional, default=
#DISCORD_MCP_DISCORD_TOKEN=

# Directory for the stored browser session and token
# optional, default=./data
#DISCORD_MCP_DISCORD_DATA_DIR=./data

# Run Chromium without a window; set to false locally to solve a captcha by hand
# optional, default=true
#DISCORD_MCP_DISCORD_HEADLESS=true

# Maximum duration of a browser login in milliseconds
# optional, default=120000
#DISCORD_MCP_DISCORD_LOGIN_TIMEOUT=120000

# Base URL of the Discord API
# optional, default=https://discord.com/api/v9
#DISCORD_MCP_DISCORD_API_URL=https://discord.com/api/v9
