{
    "compilerOptions": {
        "target":           "ES2024",
        "module":           "ESNext",
        "moduleResolution": "Bundler",
        "lib":              ["dom", "dom.iterable", "esnext"],
        "types":            ["node"],
        "strict":           true,
        "skipLibCheck":     true,
        "sourceMap":        true,
        "rootDir":          "src",
        "outDir":           "dist",
        "paths":            {
            "@/*": ["./src/*"]
        }
    },
    "tsc-alias":       {
        "resolveFullPaths": true
    },
    "include":         ["src/**/*.ts"],
    "exclude":         ["test", "dist", "coverage", "vitest.config.ts"]
}
